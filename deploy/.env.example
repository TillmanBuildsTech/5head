# Compose lives at the repository root. Copy ../.env.example to ../.env.
# This file is only the extra variables the example hooks read.
# STATE_AUTH_TOKEN must be the same bearer token compose gives the API
# (local default: local-dev-token, or Coolify's SERVICE_PASSWORD_64_FIVEHEAD).

# Match FIVEHEAD_HOST_PORT when you load docker-compose.ports.yml (smoke test uses 18080).
STATE_API_URL=http://127.0.0.1:18080
STATE_AUTH_TOKEN=local-dev-token
STATE_AGENT_NAME=hermes-local
# Optional default matter for the proxy hook when a request has no metadata.matter_id.
STATE_MATTER_ID=
