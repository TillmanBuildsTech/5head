# Optional local overrides for the root docker-compose.yml.
# Copy to .env (gitignored) only when you want to replace the local defaults.
#
# With nothing set, compose uses:
#   POSTGRES_USER=state
#   POSTGRES_PASSWORD=state
#   POSTGRES_DB=state
#   FIVEHEAD_STATE_TOKEN=local-dev-token
#
# Those defaults are for a private smoke test. docker-compose.yml publishes
# no host port. To bind one, pass docker-compose.ports.yml and set
# FIVEHEAD_HOST_PORT (required there; no default):
#   FIVEHEAD_HOST_PORT=18080 docker compose -f docker-compose.yml -f docker-compose.ports.yml up -d
# On Coolify, leave them unset and do not load the ports file. Coolify generates:
#   SERVICE_USER_POSTGRES
#   SERVICE_PASSWORD_64_POSTGRES
#   SERVICE_PASSWORD_64_FIVEHEAD   (this is the bearer token)
#   SERVICE_URL_API_8080           (public URL, proxy port 8080)
# Copy SERVICE_PASSWORD_64_FIVEHEAD into each agent's FIVEHEAD_STATE_TOKEN.
# Set FIVEHEAD_STATE_URL to that public URL (https, no container port).

# POSTGRES_USER=state
# POSTGRES_PASSWORD=replace-me
# POSTGRES_DB=state
# FIVEHEAD_STATE_TOKEN=replace-with-a-long-random-token
# FIVEHEAD_HOST_PORT=18080
# STATE_CLAIM_TTL_SECONDS=300

# examples/ hooks. Not read by compose. STATE_AUTH_TOKEN must match the bearer token.
# Use the host port you set in FIVEHEAD_HOST_PORT when the ports file is loaded.
# STATE_API_URL=http://127.0.0.1:18080
# STATE_AUTH_TOKEN=local-dev-token
# STATE_AGENT_NAME=litellm-proxy
# STATE_MATTER_ID=
