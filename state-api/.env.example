# Copy to state-api/.env. Never commit the copy.
# Generate a token with: openssl rand -hex 32

POSTGRES_USER=state
POSTGRES_PASSWORD=state
POSTGRES_DB=state

STATE_AUTH_TOKEN=replace-with-a-long-random-token
STATE_CLAIM_TTL_SECONDS=300

# Used by the MCP wrapper and the LiteLLM hook, not by docker compose itself.
STATE_API_URL=http://localhost:8080
STATE_AGENT_NAME=hermes-local
# Optional default matter for the proxy hook when a request has no metadata.matter_id.
STATE_MATTER_ID=
