<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FiveHead.State.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Npgsql" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
    <EmbeddedResource Include="Admin\admin.html" LogicalName="FiveHead.State.Api.Admin.admin.html" />
    <EmbeddedResource Include="Admin\admin.css" LogicalName="FiveHead.State.Api.Admin.admin.css" />
    <EmbeddedResource Include="Admin\admin.js" LogicalName="FiveHead.State.Api.Admin.admin.js" />
  </ItemGroup>

</Project>
